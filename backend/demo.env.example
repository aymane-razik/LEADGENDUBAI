NODE_ENV=development
DEMO_MODE=true
PORT=5010
API_VERSION=v1
MONGODB_URI=mongodb://127.0.0.1:27017/dubai-realestate-demo
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/dubai-realestate-demo-test
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=5
JWT_SECRET=generated-by-demo-env-script
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=generated-by-demo-env-script
JWT_REFRESH_EXPIRE=7d
JWT_RESET_SECRET=generated-by-demo-env-script
JWT_RESET_EXPIRE=1h
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=demo
SMTP_PASS=demo-not-sent
EMAIL_FROM=Dubai Demo <demo@example.invalid>
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
BCRYPT_ROUNDS=10
ENCRYPTION_KEY=generated-by-demo-env-script
LOG_LEVEL=info
LOG_FILE_PATH=logs/
TZ=Asia/Dubai
FRONTEND_URL=http://localhost:3010
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/
